{
  "name": "whatsapp-mcp-stream",
  "version": "1.0.0",
  "description": "TypeScript MCP server for WhatsApp using Baileys",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node --no-deprecation dist/index.js",
    "dev": "tsc -w & node --no-deprecation --watch dist/index.js",
    "debug": "npx @modelcontextprotocol/inspector node --no-deprecation --trace-deprecation dist/index.js",
    "smoke:mcp": "node scripts/smoke-mcp.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --max-warnings=0 src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "cleanup-browsers": "node dist/utils/cleanup-browsers.js"
  },
  "keywords": [
    "mcp",
    "whatsapp",
    "typescript",
    "baileys"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.9.0",
    "archiver": "^6.0.2",
    "axios": "^1.7.2",
    "baileys": "^7.0.0-rc11",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.5.0",
    "express": "^5.0.0",
    "file-type": "^21.3.4",
    "fluent-ffmpeg": "^2.1.3",
    "multer": "^2.0.0",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^5.0.0",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/pino": "^7.0.4",
    "@types/qrcode": "^1.5.5",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.3.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.6"
  }
}
